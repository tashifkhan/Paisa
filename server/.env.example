# ===========================================
# Paisa Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# MongoDB Connection String
# For local Docker: mongodb://mongo:27017/paisa
# For MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/paisa
MONGODB_URL=mongodb://mongo:27017/paisa

# JWT Secret Key (use a strong random string in production)
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT Secrets (optional, falls back to SECRET_KEY)
JWT_ACCESS_SECRET=your-access-token-secret
JWT_REFRESH_SECRET=your-refresh-token-secret

# SMTP Configuration (for sending OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Paisa <your-email@gmail.com>"
