// Serves https://billi.taf.sh: the landing page at / and the web app at /app/.
// Build first: web-deploy/build.sh
// Then deploy from the repo root: npx wrangler deploy -c web-deploy/wrangler.jsonc
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "billi-web",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Unmatched paths go to worker.js, which routes /app/* to the app.
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "billi.taf.sh", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
