            android:pathData="M42,40h24v4h-9.2c0.9,1.5 1.5,3.2 1.7,5H66v4H58.6c-0.5,4.3 -3.5,7.9 -7.6,9.6l10,12h-5.8l-9.2,-11.2H42v-4h4.2c3.1,0 5.5,-2 6.1,-4.8H42v-4h10.3c-0.6,-2.8 -3,-4.8 -6.1,-4.8H42z" />
