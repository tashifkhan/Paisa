    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Launcher art spans 24 to 84 of 108. Scaled by a third it spans 2 to 22. -->
    <group
        android:scaleX="0.33333"
        android:scaleY="0.33333"
        android:translateX="-6"
        android:translateY="-6">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M54,24c-16.5,0 -30,13.5 -30,30s13.5,30 30,30 30,-13.5 30,-30 -13.5,-30 -30,-30zM54,28c14.3,0 26,11.7 26,26s-11.7,26 -26,26 -26,-11.7 -26,-26 11.7,-26 26,-26z" />
