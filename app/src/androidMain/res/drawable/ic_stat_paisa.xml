<?xml version="1.0" encoding="utf-8"?>
<!-- Status bar icon: the launcher's coin and rupee mark, drawn to fill 24dp.
     The launcher's own monochrome layer keeps a wide margin for the adaptive
     mask, so in the status bar it came out a third of the size and blurry. -->
