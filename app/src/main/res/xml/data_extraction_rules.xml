<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup and device transfer, API 31+. Keys and passwords never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="paisa_ai_credentials.xml" />
        <exclude domain="sharedpref" path="paisa_ai_credentials_plain.xml" />
        <exclude domain="sharedpref" path="paisa_backup.xml" />
        <exclude domain="sharedpref" path="paisa_backup_plain.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="paisa_ai_credentials.xml" />
        <exclude domain="sharedpref" path="paisa_ai_credentials_plain.xml" />
        <exclude domain="sharedpref" path="paisa_backup.xml" />
        <exclude domain="sharedpref" path="paisa_backup_plain.xml" />
    </device-transfer>
</data-extraction-rules>
